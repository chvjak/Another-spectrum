            if mask & (1 << register):
                if position >= len(blob):
                    raise ValueError(f"truncated reel AY value at tick {tick}, R{register}")
                state[register] = blob[position]
                position += 1
        result.append(bytes(state))
    if position != len(blob):
        raise ValueError(f"unused reel AY bytes: {len(blob) - position}")
    return result


def snapshot(
    frames: Sequence[bytes],
    stream: bytes,
    ay_stream: bytes,
    tail_ticks: int,
    reel_number: int,
    output_directory: Path = OUT,
) -> Path:
    code = player_code(len(frames), tail_ticks)
    if len(stream) > VIDEO_STREAM_LIMIT:
        raise ValueError(f"video stream too large: {len(stream)}")
    if len(ay_stream) > AY_DATA_LIMIT:
        raise ValueError(f"AY stream too large: {len(ay_stream)}")

    pages = [bytearray(0x4000) for _ in range(8)]
    pages[2][: len(stream)] = stream
    code_offset = PLAYER_ORIGIN - 0x4000
    pages[5][code_offset : code_offset + len(code)] = code

    # IM2 vector for a floating-bus value of $FF and a minimal EI/RETI handler.
    pages[5][IM2_VECTOR_LOW_ADDRESS - 0x4000] = IM2_HANDLER_ADDRESS & 0xFF
    pages[5][IM2_VECTOR_LOW_ADDRESS + 1 - 0x4000] = IM2_HANDLER_ADDRESS >> 8
    handler_offset = IM2_HANDLER_ADDRESS - 0x4000
    pages[5][handler_offset : handler_offset + 3] = bytes((0xFB, 0xED, 0x4D))

    ay_offset = AY_DATA_ADDRESS - 0x4000
    pages[5][ay_offset : ay_offset + len(ay_stream)] = ay_stream

    header = bytearray(27)
    header[19] = 4
    header[23:25] = struct.pack("<H", 0x7FF0)
    header[25] = 2
    snapshot_blob = bytearray(header) + pages[5] + pages[2] + pages[0]
    snapshot_blob += struct.pack("<HBB", PLAYER_ORIGIN, 0, 0)
    for bank in (1, 3, 4, 6, 7):
        snapshot_blob += pages[bank]

    output_directory.mkdir(parents=True, exist_ok=True)
    path = output_directory / f"reel-{reel_number:03}.sna"
    path.write_bytes(snapshot_blob)
    return path


def build_reels(
    all_frames: Sequence[tuple[int, bytes]],
    ay_frames: Sequence[bytes],
    output_directory: Path = OUT,
) -> list[dict[str, int | str]]:
    visual_ticks = len(all_frames) * WAIT_FRAMES
    final_tail_ticks = max(0, len(ay_frames) - visual_ticks)
    reels: list[dict[str, int | str]] = []
    start = 0

    while start < len(all_frames):
        best = None
        states = [bytes(6912), bytes(6912)]
        video_builder = bytearray()
        for end in range(start + 1, min(start + 255, len(all_frames)) + 1):
            local_index = end - start - 1
            frame = all_frames[end - 1][1]
            target = local_index & 1
            for offset, data in spans(states[target], frame):
                video_builder += struct.pack("<HB", offset, len(data)) + data
            video_builder += b"\xff\xff"
            states[target] = frame

            tail_ticks = final_tail_ticks if end == len(all_frames) else 0
            ay_start = start * WAIT_FRAMES
            ay_end = end * WAIT_FRAMES + tail_ticks
            ay_rows = ay_slice(ay_frames, ay_start, ay_end)
            ay_stream = encode_ay_segment(ay_rows)
            if len(video_builder) > VIDEO_STREAM_LIMIT or len(ay_stream) > AY_DATA_LIMIT:
                break
            best = (end, bytes(video_builder), ay_stream, tail_ticks, ay_start, ay_end)
        if best is None:
            raise RuntimeError(f"single frame at index {start} exceeds a reel")

        end, video_stream, ay_stream, tail_ticks, ay_start, ay_end = best
        path = snapshot(
            [data for _, data in all_frames[start:end]],
            video_stream,
            ay_stream,
            tail_ticks,
            len(reels),
            output_directory,
        )
        reels.append(
            {
                "reel": path.name,
                "start_frame": start,
                "end_frame": end - 1,
                "frames": end - start,
                "video_bytes": len(video_stream),
                "start_ay_tick": ay_start,
                "end_ay_tick": ay_end - 1,
                "ay_ticks": ay_end - ay_start,
                "ay_bytes": len(ay_stream),
                "tail_ticks": tail_ticks,
            }
        )
        start = end
    return reels


def write_manifest(reels: Sequence[dict[str, int | str]], output_directory: Path = OUT) -> None:
    columns = [
        "reel", "start_frame", "end_frame", "frames", "video_bytes",
