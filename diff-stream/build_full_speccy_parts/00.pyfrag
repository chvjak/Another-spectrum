#!/usr/bin/env python3
"""Build ZX Spectrum 128K diff-stream reels with synchronized 50 Hz AY playback.

The visual stream alternates physical Spectrum screen banks 5 and 7. Each frame
is encoded against the previous contents of the same bank (frame N-2). AY state
is stored per reel as register deltas and advanced once after every 50 Hz HALT.
"""

from __future__ import annotations

from concurrent.futures import ProcessPoolExecutor
from pathlib import Path
import base64
import os
import struct
import zlib
from typing import Iterable, Sequence

from PIL import Image

ROOT = Path(__file__).resolve().parent
OUT = ROOT / os.environ.get("SPECCY_OUTPUT", "full-speccy")
CAPTURE = ROOT / os.environ.get("SPECCY_CAPTURE", "captured")
WAIT_FRAMES = int(os.environ.get("SPECCY_WAIT_FRAMES", "2"))
AY_SOURCE = Path(
    os.environ.get(
        "SPECCY_AY_STREAM",
        str(ROOT.parent / "music" / "v6" / "aw_intro_ay_v6_2m50s.bin.zlib.b64"),
    )
)

PLAYER_ORIGIN = 0x5B00
IM2_VECTOR_LOW_ADDRESS = 0x5CFF
IM2_HANDLER_ADDRESS = 0x5D10
AY_DATA_ADDRESS = 0x5D20
VIDEO_STREAM_LIMIT = 0x3F00
AY_DATA_LIMIT = 0x8000 - AY_DATA_ADDRESS

PAL = [
    (0, 0, 0), (32, 48, 192), (192, 64, 16), (192, 64, 192),
    (64, 176, 16), (80, 192, 176), (224, 192, 16), (192, 192, 192),
    (0, 0, 0), (48, 64, 255), (255, 64, 48), (255, 112, 240),
    (80, 224, 16), (80, 224, 255), (255, 232, 80), (255, 255, 255),
]


def spectrum_offset(y: int, xb: int) -> int:
    return ((y & 0xC0) << 5) | ((y & 7) << 8) | ((y & 0x38) << 2) | xb


def convert(item: tuple[int, Path]) -> int:
    number, path = item
    image = Image.open(path).convert("RGB").resize((256, 192), Image.Resampling.LANCZOS)
    pixels = image.load()
    output = bytearray(6912)
    for cell_y in range(24):
        for cell_x in range(32):
            colors = [
                pixels[cell_x * 8 + x, cell_y * 8 + y]
                for y in range(8)
                for x in range(8)
            ]
            best = None
            for bright in (0, 1):
                base = bright * 8
                for paper in range(8):
                    for ink in range(8):
                        paper_rgb, ink_rgb = PAL[base + paper], PAL[base + ink]
                        error = sum(
                            min(
                                (red - paper_rgb[0]) ** 2
                                + (green - paper_rgb[1]) ** 2
                                + (blue - paper_rgb[2]) ** 2,
                                (red - ink_rgb[0]) ** 2
                                + (green - ink_rgb[1]) ** 2
                                + (blue - ink_rgb[2]) ** 2,
                            )
                            for red, green, blue in colors
                        )
                        if best is None or error < best[0]:
                            best = (error, bright, paper, ink, paper_rgb, ink_rgb)
            assert best is not None
            _, bright, paper, ink, paper_rgb, ink_rgb = best
            output[6144 + cell_y * 32 + cell_x] = (bright << 6) | (paper << 3) | ink
            for yy in range(8):
                bits = 0
                for xx in range(8):
                    red, green, blue = colors[yy * 8 + xx]
                    paper_distance = (
                        (red - paper_rgb[0]) ** 2
                        + (green - paper_rgb[1]) ** 2
                        + (blue - paper_rgb[2]) ** 2
                    )
                    ink_distance = (
                        (red - ink_rgb[0]) ** 2
                        + (green - ink_rgb[1]) ** 2
                        + (blue - ink_rgb[2]) ** 2
                    )
                    bits = (bits << 1) | (ink_distance < paper_distance)
                output[spectrum_offset(cell_y * 8 + yy, cell_x)] = bits
    destination = OUT / f"frame-{number:04}.scr"
    destination.write_bytes(output)
    return number


def spans(old: bytes, new: bytes) -> list[tuple[int, bytes]]:
    changed = [index for index, (before, after) in enumerate(zip(old, new)) if before != after]
    result: list[tuple[int, bytes]] = []
    index = 0
    while index < len(changed):
        start = end = changed[index]
        index += 1
        while (
            index < len(changed)
            and changed[index] - end <= 3
            and changed[index] - start < 255
        ):
            end = changed[index]
            index += 1
        result.append((start, new[start : end + 1]))
    return result


class Asm:
